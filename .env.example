# ---------------------------------------------------------------------------
# WellBot - exemple de configuration
# Copier ce fichier en .env puis lancer : php artisan key:generate
# ---------------------------------------------------------------------------

APP_NAME=WellBot
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# L'interface est entierement en francais (dates, "il y a 2 heures", ...)
APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fr_FR

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# ---------------------------------------------------------------------------
# Base de donnees
# ---------------------------------------------------------------------------
# Par defaut SQLite : creer un fichier vide database/database.sqlite et c'est
# pret. Pour MySQL (XAMPP / phpMyAdmin), commenter la ligne sqlite et
# decommenter le bloc suivant.

DB_CONNECTION=sqlite

# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=bien_etre_etudiant
# DB_USERNAME=root
# DB_PASSWORD=

# ---------------------------------------------------------------------------
# Sessions, cache, files d'attente
# ---------------------------------------------------------------------------
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log

MAIL_MAILER=log

# ---------------------------------------------------------------------------
# WellBot : intelligence artificielle (facultatif)
# ---------------------------------------------------------------------------
# Cle gratuite : https://aistudio.google.com/app/apikey
# Laisser vide fonctionne : l'assistant utilise alors les mots-cles definis
# dans l'espace administrateur.

GEMINI_API_KEY=
